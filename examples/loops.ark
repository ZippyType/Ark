// loops.ark - Loops and Control Flow
// Demonstrating while loops and for loops in Ark

// While loop - countdown
fn countdown(n) (
    while (n > 0) (
        print(n)
        n = n - 1
    )
    print("Blastoff!")
)

countdown(5)

// For loop - iterate through range
fn print_range(start, end) (
    for (i in range(start, end)) (
        print(i)
    )
)

// Sum all numbers from 1 to 10
fn sum_to_n(n) (
    let total = 0
    let i = 1
    while (i <= n) (
        total = total + i
        i = i + 1
    )
    return total
)

let result = sum_to_n(10)
print("Sum 1 to 10: " + result)

// Factorial
fn factorial(n) (
    if (n <= 1) (
        return 1
    ) else (
        return n * factorial(n - 1)
    )
)

print("5! = " + factorial(5))
