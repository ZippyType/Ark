win = window("Layout Example", 400, 300)

top_frame = frame(win)
top_frame.pack(side=TOP, fill=X)

label(top_frame, "Header").pack(side=LEFT)
label(top_frame, "Nav").pack(side=RIGHT)

bottom_frame = frame(win)
bottom_frame.pack(side=BOTTOM, fill=X)

label(bottom_frame, "Footer").pack()

center_frame = frame(win)
center_frame.pack(fill=BOTH, expand=true)

label(center_frame, "Main Content").pack()

win.mainloop()