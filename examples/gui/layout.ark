import tkinter as tk

win = tk.Tk()
win.title("Layout Example")

frame = tk.Frame(win)
frame.pack()

tk.Label(frame, text="Top Left").pack(side=tk.LEFT)
tk.Label(frame, text="Top Right").pack(side=tk.LEFT)

tk.Button(win, text="Bottom", bg="lightblue").pack(fill=tk.X, side=tk.BOTTOM)

win.mainloop()