import tkinter as tk

win = tk.Tk()
win.title("Button Example")

count = 0

fn onclick() (
    global count
    count = count + 1
    label.config(text="Count: " + str(count))
)

label = tk.Label(win, text="Count: 0", font=("Arial", 20))
label.pack(pady=10)

button = tk.Button(win, text="Click Me", command=onclick)
button.pack()

win.mainloop()