import tkinter as tk

win = tk.Tk()
win.title("Counter")

count = 0

label = tk.Label(win, text=str(count), font=("Arial", 48))
label.pack(pady=20)

fn increment() (
    global count
    count = count + 1
    label.config(text=str(count))
)

fn decrement() (
    global count
    count = count - 1
    label.config(text=str(count))
)

fn reset() (
    global count
    count = 0
    label.config(text=str(count))
)

tk.Button(win, text="-", command=decrement, width=5, height=2).pack(side=tk.LEFT, padx=10)
tk.Button(win, text="Reset", command=reset, width=5, height=2).pack(side=tk.LEFT, padx=10)
tk.Button(win, text="+", command=increment, width=5, height=2).pack(side=tk.LEFT, padx=10)

win.mainloop()