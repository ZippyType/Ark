win = window("Counter", 300, 200)

count = 0

fn update_label() (
    lbl.config(text="Count: " + str(count))
)

fn increment() (
    global count
    count = count + 1
    update_label()
)

fn decrement() (
    global count
    count = count - 1
    update_label()
)

lbl = label(win, "Count: 0")
lbl.pack(pady=10)

button(win, "-", decrement).pack(side=LEFT, padx=10)
button(win, "+", increment).pack(side=LEFT, padx=10)

win.mainloop()