win = window("Simple Calculator", 250, 350)

display = entry(win, justify=CENTER)
display.config(font=Font("Arial", 24), width=15)
display.grid(row=0, column=0, columnspan=3, padx=10, pady=10)

num = ""
op = ""
first = 0

fn append_num(n) (
    global num
    num = num + str(n)
    display.delete(0, END)
    display.insert(0, num)
)

fn do_op(operation) (
    global first, op, num
    first = int(num)
    op = operation
    num = ""
)

fn equals() (
    global first, op, num
    if (num != "" and op != "") (
        second = int(num)
        result = 0
        if (op == "+") (
            result = first + second
        ) elif (op == "-") (
            result = first - second
        ) elif (op == "*") (
            result = first * second
        ) elif (op == "/") (
            result = first / second
        )
        display.delete(0, END)
        display.insert(0, str(result))
        num = str(result)
        op = ""
    )
)

fn clear() (
    global num, first, op
    num = ""
    first = 0
    op = ""
    display.delete(0, END)
)

btn7 = button(win, "7")
btn7.config(command=lambda: append_num(7))
btn7.grid(row=1, column=0)

btn8 = button(win, "8")
btn8.config(command=lambda: append_num(8))
btn8.grid(row=1, column=1)

btn9 = button(win, "9")
btn9.config(command=lambda: append_num(9))
btn9.grid(row=1, column=2)

btn4 = button(win, "4")
btn4.config(command=lambda: append_num(4))
btn4.grid(row=2, column=0)

btn5 = button(win, "5")
btn5.config(command=lambda: append_num(5))
btn5.grid(row=2, column=1)

btn6 = button(win, "6")
btn6.config(command=lambda: append_num(6))
btn6.grid(row=2, column=2)

btn1 = button(win, "1")
btn1.config(command=lambda: append_num(1))
btn1.grid(row=3, column=0)

btn2 = button(win, "2")
btn2.config(command=lambda: append_num(2))
btn2.grid(row=3, column=1)

btn3 = button(win, "3")
btn3.config(command=lambda: append_num(3))
btn3.grid(row=3, column=2)

btn0 = button(win, "0")
btn0.config(command=lambda: append_num(0))
btn0.grid(row=4, column=0)

btnC = button(win, "C")
btnC.config(command=clear)
btnC.grid(row=4, column=1)

btnE = button(win, "=")
btnE.config(command=equals)
btnE.grid(row=4, column=2)

win.mainloop()