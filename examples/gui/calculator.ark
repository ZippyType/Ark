import tkinter as tk

win = tk.Tk()
win.title("Calculator")

entry = tk.Entry(win, width=20, font=("Arial", 20), justify=tk.RIGHT)
entry.grid(row=0, column=0, columnspan=4)

fn click(num) (
    current = entry.get()
    entry.delete(0, tk.END)
    entry.insert(0, current + str(num))
)

def create_button(text, row, col) (
    btn = tk.Button(win, text=text, width=5, height=2, command=lambda: click(text))
    btn.grid(row=row, column=col)
)

i = 1
col = 0
while (i <= 9) (
    create_button(i, (i - 1) / 3 + 1, col)
    i = i + 1
    if (col == 2) col = 0 else col = col + 1
)

create_button("0", 4, 0)

win.mainloop()